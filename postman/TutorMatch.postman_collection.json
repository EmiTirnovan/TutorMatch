	"item": [
		{
			"name": "CreateTutor",
			"item": [
				{
					"name": "Happy – Create valid tutor (201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
									"var json = pm.response.json();",
									"pm.collectionVariables.set('tutorId', json.id);",
									"pm.collectionVariables.set('tutorToDeleteId', json.id);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ion Popescu\",\n  \"email\": \"ion@tutormatch.ro\",\n  \"bio\": \"Tutor experimentat la Algoritmi.\",\n  \"hourlyRate\": 80,\n  \"subjectIds\": [],\n  \"availability\": []\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/tutors", "host": ["{{baseUrl}}"], "path": ["api", "tutors"] }
					}
				},
				{
					"name": "Error – Create tutor with empty name (400)",
					"event": [
						{
							"listen": "test",
